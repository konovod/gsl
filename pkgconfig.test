#!/bin/sh

set -e
# skip test if we have no pkg-config
pkg-config --version >/dev/null 2>&1 || exit 77
PKG_CONFIG_PATH=.
export PKG_CONFIG_PATH 
pkg-config --define-variable=GSL_CBLAS_LIB=-lfoo --libs gsl | grep 'lfoo' > /dev/null 2>&1

# gsl-without-cblas must not pull in the CBLAS library
if pkg-config --define-variable=GSL_CBLAS_LIB=-lfoo --libs gsl-without-cblas | grep 'lfoo' > /dev/null 2>&1; then
    echo "gsl-without-cblas.pc unexpectedly references CBLAS" >&2
    exit 1
fi
exit 0
